<style>
  :root {
    --blue-950: #0b1f4d;
    --blue-900: #0e2760;
    --blue-800: #123a8c;
    --blue-700: #1656d1;
    --blue-600: #2166f0;
    --blue-100: #e8f0ff;
    --blue-50:  #f4f8ff;
    --yellow:    #ffc93c;
    --yellow-dark:#e6a70f;
    --green-600: #10b981;
    --ink:       #0d1730;
    --ink-soft:  #4a5578;
    --white:     #ffffff;
    --line:      #dce6fb;
    --radius-lg: 22px;
    --radius-md: 16px;
    --radius-sm: 10px;
    --shadow-soft: 0 10px 30px -12px rgba(18, 58, 140, 0.18);
    --shadow-card: 0 6px 18px -8px rgba(18, 58, 140, 0.14);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--ink);
    background:
      radial-gradient(1200px 600px at 15% -10%, #eaf1ff 0%, transparent 60%),
      radial-gradient(900px 500px at 110% 10%, #fff8e0 0%, transparent 55%),
      var(--blue-50);
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
  }

  h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; margin: 0; line-height: 1.2; }
  a { color: inherit; text-decoration: none; }

  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ---------- BREADCRUMB ---------- */
  .breadcrumb {
    padding: 16px 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a { color: var(--blue-700); font-weight: 500; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* ---------- TOP BRAND BAR ---------- */
  .brandbar {
    padding: 16px 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--blue-800);
  }
  .brand-dot {
    width: 12px; height: 12px; border-radius: 3px;
    background: linear-gradient(135deg, var(--blue-600), var(--blue-800));
    transform: rotate(45deg);
    flex: none;
  }
  .brand span.go { color: var(--yellow-dark); }
  .nav-back {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--blue-700);
    background: var(--white);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    transition: background .2s, border-color .2s;
  }
  .nav-back:hover { background: var(--blue-100); border-color: var(--blue-600); }

  /* ---------- HERO ---------- */
  .hero {
    text-align: center;
    padding: 30px 0 10px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--blue-700);
    font-weight: 700;
    font-size: 0.84rem;
    padding: 6px 16px;
    border-radius: 999px;
    box-shadow: var(--shadow-card);
    margin-bottom: 18px;
  }
  .eyebrow .live-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--green-600);
    box-shadow: 0 0 8px var(--green-600);
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--blue-950);
    margin-bottom: 12px;
  }
  .hero .amount {
    display: inline-block;
    position: relative;
    color: var(--blue-800);
    padding: 0 6px;
  }
  .hero .amount .highlight-bg {
    position: absolute;
    left: -2px; right: -2px; bottom: 2px;
    height: 0.42em;
    background: var(--yellow);
    z-index: 0;
    border-radius: 3px;
  }
  .hero .amount span { position: relative; z-index: 1; }
  .hero p.sub {
    margin: 12px auto 0;
    max-width: 650px;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* ---------- COUPON TICKET ---------- */
  .coupon-section {
    padding: 26px 0 12px;
    display: flex;
    justify-content: center;
  }
  .coupon {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: linear-gradient(135deg, var(--blue-700), var(--blue-950));
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    color: var(--white);
    box-shadow: var(--shadow-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    overflow: visible;
  }
  .coupon::before,
  .coupon::after {
    content: "";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 26px; height: 26px;
    background: var(--blue-50);
    border-radius: 50%;
  }
  .coupon::before { left: -13px; }
  .coupon::after { right: -13px; }
  .coupon-notch {
    position: absolute;
    top: 0; bottom: 0;
    left: 64%;
    border-left: 2px dashed rgba(255,255,255,0.3);
  }
  .coupon-left {
    padding-right: 18px;
  }
  .coupon-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--blue-100);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .coupon-code {
    font-family: 'Manrope', sans-serif;
    font-weight: 900;
    font-size: 1.8rem;
    letter-spacing: 0.06em;
    color: var(--yellow);
  }
  .copy-btn {
    flex: none;
    background: var(--yellow);
    color: var(--blue-950);
    border: none;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 13px 22px;
    border-radius: 12px;
    cursor: pointer;
    transition: transform .15s ease, background .2s ease;
    white-space: nowrap;
    min-width: 136px;
  }
  .copy-btn:hover { background: #ffd766; }
  .copy-btn:active { transform: scale(0.96); }
  .copy-btn.copied { background: #3fd17e; color: var(--white); }

  /* ---------- SECTION HEADERS ---------- */
  .section-heading {
    text-align: center;
    margin: 44px 0 24px;
  }
  .section-heading h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--blue-950);
  }
  .section-heading p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin-top: 6px;
  }

  /* ---------- OFFERS TABLE ---------- */
  .table-container {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow-x: auto;
    margin-bottom: 30px;
  }
  .offers-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.94rem;
  }
  .offers-table th {
    background: var(--blue-950);
    color: var(--white);
    padding: 14px 18px;
    font-weight: 700;
    font-family: 'Manrope', sans-serif;
    letter-spacing: 0.02em;
  }
  .offers-table td {
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .offers-table tr:last-child td { border-bottom: none; }
  .offers-table tr:hover { background: var(--blue-50); }
  .badge-code {
    background: #fff4d4;
    color: #925400;
    font-family: monospace;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid #f2cf78;
    display: inline-block;
  }
  .badge-status {
    background: #e6f9f0;
    color: #0d8a52;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 3px 8px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .btn-table {
    background: var(--blue-700);
    color: var(--white);
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.86rem;
    display: inline-block;
    transition: background .2s;
  }
  .btn-table:hover { background: var(--blue-800); }

  /* ---------- REFERRAL GRID ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    padding-bottom: 6px;
  }
  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 24px 24px 22px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -12px rgba(18, 58, 140, 0.22);
  }
  .card.wide {
    grid-column: 1 / -1;
  }
  .card-title {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.18rem;
    color: var(--blue-950);
  }
  .card-linklabel {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .card-url {
    display: block;
    font-size: 0.88rem;
    color: var(--blue-700);
    word-break: break-all;
    text-decoration: none;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 2px;
  }
  .card-url:hover { text-decoration: underline; }
  .cta-btn {
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--blue-700);
    color: var(--white);
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 14px 20px;
    border-radius: 12px;
    transition: background .18s ease, transform .15s ease;
  }
  .cta-btn:hover { background: var(--blue-800); }
  .cta-btn:active { transform: scale(0.98); }
  .cta-btn .arrow { transition: transform .18s ease; }
  .cta-btn:hover .arrow { transform: translateX(4px); }

  /* ---------- NEET SECTION ---------- */
  .neet-card {
    margin-top: 12px;
    background: linear-gradient(135deg, #fff6dc, #fff0c2);
    border: 1px solid #f4dd8b;
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 10px 26px -14px rgba(230, 167, 15, 0.5);
  }
  .neet-text h3 {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--blue-950);
  }
  .neet-text p {
    margin: 6px 0 0;
    font-size: 0.98rem;
    color: #7a5b00;
    font-weight: 600;
  }
  .neet-card .cta-btn {
    background: var(--blue-950);
    flex: none;
  }
  .neet-card .cta-btn:hover { background: #08153c; }

  /* ---------- HOW TO REDEEM SECTION ---------- */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .step-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 20px;
    box-shadow: var(--shadow-card);
    text-align: center;
    position: relative;
  }
  .step-number {
    width: 36px; height: 36px;
    background: var(--blue-700);
    color: var(--white);
    font-weight: 800;
    font-size: 1.1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    font-family: 'Manrope', sans-serif;
  }
  .step-card h3 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--blue-950);
    margin-bottom: 6px;
  }
  .step-card p {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 0;
  }

  /* ---------- CONTENT BLOCK (SEO RICH CONTENT) ---------- */
  .content-block {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 32px 36px;
    margin: 40px 0;
    box-shadow: var(--shadow-card);
  }
  .content-block h2 {
    font-size: 1.5rem;
    color: var(--blue-950);
    margin-bottom: 16px;
    font-weight: 800;
  }
  .content-block h3 {
    font-size: 1.2rem;
    color: var(--blue-800);
    margin: 22px 0 10px;
    font-weight: 700;
  }
  .content-block p {
    font-size: 0.98rem;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .content-block ul {
    padding-left: 20px;
    margin-bottom: 16px;
  }
  .content-block li {
    margin-bottom: 8px;
    font-size: 0.96rem;
    color: var(--ink-soft);
  }

  /* ---------- FAQ ACCORDION ---------- */
  .faq-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
  }
  .faq-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color .2s;
  }
  .faq-item[open] {
    border-color: var(--blue-600);
  }
  .faq-summary {
    padding: 18px 22px;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--blue-950);
    cursor: pointer;
    font-family: 'Manrope', sans-serif;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::after {
    content: "＋";
    font-size: 1.2rem;
    color: var(--blue-700);
    font-weight: 800;
  }
  .faq-item[open] .faq-summary::after {
    content: "－";
  }
  .faq-answer {
    padding: 0 22px 20px;
    font-size: 0.96rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--blue-50);
    margin-top: 4px;
    padding-top: 14px;
  }

  /* ---------- FOOTNOTE ---------- */
  .footnote {
    text-align: center;
    margin: 38px 0 40px;
    font-size: 0.88rem;
    color: var(--ink-soft);
    padding: 0 20px;
  }
  .footnote strong { color: var(--blue-800); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
    .coupon {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: 24px 20px;
    }
    .coupon-notch { display: none; }
    .coupon-left { padding-right: 0; }
    .copy-btn { width: 100%; }
    .neet-card {
      flex-direction: column;
      text-align: center;
