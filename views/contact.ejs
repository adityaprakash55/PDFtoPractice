        <div class="max-w-7xl mx-auto px-6 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10 pb-8 border-b-2 border-black">
                <div class="md:col-span-2 space-y-4">
                    <div class="flex items-center space-x-3">
                        <img src="logo-light.png" alt="Logo" class="w-9 h-9 border-2 border-black dark:hidden">
                        <img src="logo-dark.png" alt="Logo" class="w-9 h-9 border-2 border-black hidden dark:block">
                        <span class="text-xl font-black tracking-tight uppercase" style="color: var(--text-primary);">PDF to PRACTICE</span>
                    </div>
                    <p class="text-sm font-bold max-w-sm leading-relaxed" style="color: var(--text-muted);">
                        Transform coaching DPPs, PYQs, and test PDFs into interactive JEE/NEET CBT Mock Simulators instantly.
                    </p>
                    <div class="flex items-center gap-3">
                        <a href="https://t.me/PDFtoPractice" target="_blank" rel="noopener" class="brutal-btn px-3 py-1.5 text-xs font-black uppercase bg-[#229ED9] text-white flex items-center gap-1.5">
