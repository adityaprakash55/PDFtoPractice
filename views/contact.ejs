            <!-- Telegram Contact Card -->
            <div class="brutal-card p-8 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -top-12 -right-12 w-36 h-36 bg-sky-400/20 rounded-full blur-2xl pointer-events-none"></div>
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-14 h-14 bg-[#229ED9] text-white border-2 border-black shadow-[3px_3px_0px_0px_#000] flex items-center justify-center">
                            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
                                <path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.562 8.161c-.18.717-.962 4.084-1.362 5.752-.169.706-.433.943-.684.966-.547.05-1.002-.387-1.533-.735-.83-.544-1.301-.883-2.107-1.413-.93-.614-.327-.951.203-1.503.138-.144 2.535-2.324 2.582-2.523.006-.025.01-.119-.045-.168s-.136-.032-.195-.019c-.083.018-1.408.895-3.974 2.628-.376.258-.717.385-1.022.378-.337-.008-.985-.191-1.467-.348-.592-.192-1.062-.294-1.021-.621.021-.17.256-.345.704-.524 2.766-1.204 4.61-1.998 5.534-2.383 2.637-1.099 3.183-1.29 3.539-1.296.078-.001.253.018.366.11.096.078.123.184.135.258.012.075.027.243.014.408z"/>
                            </svg>
                        </div>
                        <span class="px-2.5 py-1 text-[10px] font-black uppercase bg-sky-400 text-black border-2 border-black">Fast Response</span>
                    </div>
                    <h2 class="text-2xl font-black uppercase tracking-tight mb-2" style="color: var(--text-primary);">Telegram Support</h2>
                    <p class="text-xs font-mono font-bold text-sky-500 mb-4">https://t.me/PDFtoPractice</p>
                    <p class="text-sm font-bold leading-relaxed mb-6" style="color: var(--text-muted);">
                        Join our official Telegram channel and community to report bugs, suggest features, receive release notifications, and get direct assistance.
                    </p>
                </div>
                
                <a href="https://t.me/PDFtoPractice" target="_blank" rel="noopener" class="brutal-btn px-5 py-3 bg-[#229ED9] hover:bg-[#1f8ebd] text-white font-black uppercase text-sm flex items-center justify-center gap-2">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.562 8.161c-.18.717-.962 4.084-1.362 5.752-.169.706-.433.943-.684.966-.547.05-1.002-.387-1.533-.735-.83-.544-1.301-.883-2.107-1.413-.93-.614-.327-.951.203-1.503.138-.144 2.535-2.324 2.582-2.523.006-.025.01-.119-.045-.168s-.136-.032-.195-.019c-.083.018-1.408.895-3.974 2.628-.376.258-.717.385-1.022.378-.337-.008-.985-.191-1.467-.348-.592-.192-1.062-.294-1.021-.621.021-.17.256-.345.704-.524 2.766-1.204 4.61-1.998 5.534-2.383 2.637-1.099 3.183-1.29 3.539-1.296.078-.001.253.018.366.11.096.078.123.184.135.258.012.075.027.243.014.408z"/></svg>
                    <span>Telegram Us @PDFtoPractice</span>
                </a>
            </div>

            <!-- Email Contact Card -->
            <div class="brutal-card p-8 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -top-12 -right-12 w-36 h-36 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <div class="w-14 h-14 bg-amber-400 text-black border-2 border-black shadow-[3px_3px_0px_0px_#000] flex items-center justify-center">
                            <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <span class="px-2.5 py-1 text-[10px] font-black uppercase bg-amber-400 text-black border-2 border-black">Official Mail</span>
                    </div>
                    <h2 class="text-2xl font-black uppercase tracking-tight mb-2" style="color: var(--text-primary);">Email Support</h2>
                    <p class="text-xs font-mono font-bold text-amber-500 mb-4">support@pdftopractice.in</p>
                    <p class="text-sm font-bold leading-relaxed mb-6" style="color: var(--text-muted);">
                        Prefer email? Drop us a line for direct support, business inquiries, or detailed bug reports with attached screenshots.
                    </p>
                </div>

                <a href="mailto:support@pdftopractice.in" class="brutal-btn px-5 py-3 bg-amber-400 hover:bg-amber-300 text-black font-black uppercase text-sm flex items-center justify-center gap-2">
                    <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span>Email Us (support@pdftopractice.in)</span>
                </a>
            </div>

        </div>

        <!-- Quick Interactive Contact Form -->
        <div class="brutal-card p-6 sm:p-8">
            <div class="flex items-center space-x-3 mb-6">
                <div class="p-2 bg-emerald-400 text-black border-2 border-black">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                </div>
                <h3 class="text-xl font-black uppercase tracking-tight" style="color: var(--text-primary);">Send Quick Feedback</h3>
            </div>

            <form id="contactForm" onsubmit="handleContactSubmit(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-black uppercase mb-1" style="color: var(--text-primary);">Your Name</label>
