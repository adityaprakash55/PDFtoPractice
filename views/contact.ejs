                    </div>
                    <div>
                        <label class="block text-xs font-black uppercase mb-1" style="color: var(--text-primary);">Category</label>
                        <select id="contactCategory" class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-800 border-2 border-black font-bold text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400" style="color: var(--text-primary);">
                            <option value="Bug Report">🐛 Bug Report</option>
                            <option value="Feature Request">💡 Feature Request</option>
                            <option value="General Support">❓ General Support</option>
                            <option value="Other Feedback">❤️ Other Feedback</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-black uppercase mb-1" style="color: var(--text-primary);">Your Message</label>
                    <textarea id="contactMessage" rows="4" required placeholder="Type your message or details here..." class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-800 border-2 border-black font-bold text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400" style="color: var(--text-primary);"></textarea>
                </div>
                <button type="submit" class="brutal-btn w-full py-3.5 bg-emerald-400 hover:bg-emerald-300 text-black font-black uppercase text-sm flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                    <span>Compose Email via Client</span>
                </button>
            </form>
        </div>

    </main>

    <!-- Footer -->
