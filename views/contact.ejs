<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>">
    
    <!-- Vercel Speed Insights -->
    <script>
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <!-- SEO & Meta Tags -->
    <meta name="description" content="<%= description %>">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Local CSS -->
    <link rel="stylesheet" href="/styles.css">
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style>
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
        
        .brutal-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 3px solid #000;
            box-shadow: 5px 5px 0px 0px #000;
        }
        .dark .brutal-card {
            background: rgba(15, 23, 42, 0.85);
            border: 3px solid #000;
            box-shadow: 5px 5px 0px 0px #000;
        }
        .brutal-btn {
            border: 2.5px solid #000;
            box-shadow: 3px 3px 0px 0px #000;
            transition: all 0.15s ease;
        }
        .brutal-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0px 0px #000;
        }
        .brutal-btn:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px 0px #000;
        }
    </style>
    <link rel="preload" href="logo.png" as="image">

    <!-- Safari & Apple Specific Meta -->
    <link rel="apple-touch-icon" href="/logo.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#0a192f">

    <!-- Universal Social/Search Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://pdftopractice.in/logo-light.png">
    <meta property="og:image" content="https://pdftopractice.in/logo-light.png">

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.png">
</head>
<body class="font-sans transition-colors duration-200 relative min-h-screen flex flex-col justify-between overflow-x-hidden">
    
    <!-- Animated Background Mesh -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
        <div class="absolute top-0 -left-4 w-72 h-72 bg-cyan-400/20 dark:bg-cyan-900/30 rounded-full filter blur-3xl opacity-70 animate-blob"></div>
        <div class="absolute top-0 -right-4 w-72 h-72 bg-emerald-400/20 dark:bg-emerald-900/30 rounded-full filter blur-3xl opacity-70 animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-72 h-72 bg-amber-400/20 dark:bg-amber-900/30 rounded-full filter blur-3xl opacity-70 animate-blob animation-delay-4000"></div>
    </div>

    <!-- Theme Toggle Button -->
    <button id="themeToggleBtn" aria-label="Toggle Theme" title="Toggle Theme" class="fixed top-4 right-4 z-[100] p-3 brutal-btn bg-white dark:bg-slate-800 text-yellow-500 dark:text-yellow-400 hover:bg-gray-100 dark:hover:bg-slate-700 cursor-pointer">
        <svg id="themeIconSun" class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <svg id="themeIconMoon" class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
    </button>

    <!-- Header Bar -->
    <header class="header-bar border-b-[3.5px] border-black sticky top-0 z-40 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-3 group">
                <div class="bg-yellow-400 text-black p-2 border-2 border-black shadow-[2px_2px_0px_0px_#000] group-hover:bg-cyan-400 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </div>
                <span class="text-lg sm:text-xl font-black uppercase tracking-tight" style="color: var(--text-primary);">PDF to PRACTICE</span>
            </a>
            
            <div class="flex items-center space-x-3">
                <a href="https://t.me/PDFtoPractice" target="_blank" rel="noopener" aria-label="Telegram" title="Telegram Channel" class="p-2 brutal-card border-[2.5px] border-black shadow-[3px_3px_0px_0px_#000] hover:bg-sky-100 dark:hover:bg-sky-900/40 transition-all cursor-pointer flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#229ED9]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.562 8.161c-.18.717-.962 4.084-1.362 5.752-.169.706-.433.943-.684.966-.547.05-1.002-.387-1.533-.735-.83-.544-1.301-.883-2.107-1.413-.93-.614-.327-.951.203-1.503.138-.144 2.535-2.324 2.582-2.523.006-.025.01-.119-.045-.168s-.136-.032-.195-.019c-.083.018-1.408.895-3.974 2.628-.376.258-.717.385-1.022.378-.337-.008-.985-.191-1.467-.348-.592-.192-1.062-.294-1.021-.621.021-.17.256-.345.704-.524 2.766-1.204 4.61-1.998 5.534-2.383 2.637-1.099 3.183-1.29 3.539-1.296.078-.001.253.018.366.11.096.078.123.184.135.258.012.075.027.243.014.408z"/></svg>
                </a>
                <a href="mailto:support@pdftopractice.in" aria-label="Email Us" title="Email Support" class="p-2 brutal-card border-[2.5px] border-black shadow-[3px_3px_0px_0px_#000] hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-all cursor-pointer flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </a>
                <a href="/donate" class="hidden sm:flex px-3.5 py-2 bg-pink-400 hover:bg-pink-300 border-[2.5px] border-black shadow-[3px_3px_0px_0px_#000] font-black uppercase text-xs hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all items-center gap-1">
