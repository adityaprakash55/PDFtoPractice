                            <div class="mt-2 text-sm text-yellow-700 dark:text-yellow-400/90 font-medium">
                                <p>If you are a student, please don't donate more than Rs 50. Student lives are tough and I want you guys to utilize your money for something better!</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- QR Code Image -->
                <div class="flex flex-col items-center justify-center">
                    <div class="bg-white/50 dark:bg-slate-800/50   overflow-hidden p-2 mb-6 transform hover:scale-105 transition-transform duration-300">
                        <img id="qrImage" src="upi_qr.jpg" alt="UPI QR Code" class="w-64 h-auto object-contain  border " onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\\'w-64 h-64 flex flex-col items-center justify-center  p-4 text-center\\'><svg class=\\'w-12 h-12 mb-3 opacity-50 text-red-400\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\\'></path></svg><span class=\\'text-sm font-bold  dark:text-white\\'>Image not found!</span><span class=\\'text-xs mt-2 text-slate-500\\'>You must download the QR code image and save it into the <b>pdf2test</b> folder as <code class=\\'bg-gray-200 dark:bg-gray-700 px-1 rounded\\'>upi_qr.jpg</code></span></div>';">
                    </div>
                    
                    <!-- UPI ID Box -->
                    <div class="brutal-card p-4 flex items-center justify-between w-full max-w-sm group mb-4 transition-colors">
                        <div class="flex flex-col text-left">
                            <span class="text-[10px] uppercase font-bold tracking-wider mb-1" style="color:var(--text-muted)">Direct UPI ID</span>
                            <span id="upiIdText" class="text-sm font-bold font-mono" style="color:var(--text-primary)">Undatedarc@axl</span>
                        </div>
