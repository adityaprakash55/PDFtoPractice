<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>">
    
    <!-- Vercel Speed Insights -->
    <script>
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <!-- SEO & Meta Tags -->
    <meta name="description" content="<%= description %>">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <!-- Local CSS -->
    <link rel="stylesheet" href="/styles.css">
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="preload" href="logo.png" as="image">

    <!-- Safari & Apple Specific Meta -->
    <link rel="apple-touch-icon" href="/logo.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#000000">

    <!-- Universal Social/Search Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://pdftopractice.in/logo.png">
    <meta property="og:image" content="https://pdftopractice.in/logo.png">

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.png">
</head>
<body class="bg-[#f4f4f0] dark:bg-[#0a0b0e] text-black dark:text-white font-sans transition-colors duration-200 relative min-h-screen overflow-x-hidden flex flex-col">
    
    <!-- Theme Toggle Button -->
    <button id="themeToggleBtn" class="fixed top-4 right-4 z-[100] p-3 rounded-full bg-white dark:bg-[#11131c] shadow-[4px_4px_0px_0px_#000] border-[3px] border-black text-yellow-500 dark:text-yellow-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-[2px_2px_0px_0px_#000]">
        <svg id="themeIconSun" class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <svg id="themeIconMoon" class="w-6 h-6 block dark:hidden text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
    </button>

    <header class="border-b-[3.5px] border-black bg-white dark:bg-[#0f111a] sticky top-0 z-40">
        <div class="max-w-4xl mx-auto px-4 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 px-5 py-2.5 bg-cyan-400 text-black font-black uppercase text-xs tracking-wider border-[3px] border-black shadow-[4px_4px_0px_0px_#000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#000] active:translate-x-0 active:translate-y-0 transition-all select-none">
                <svg class="w-4 h-4 text-black shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                <span>Back to Home</span>
            </a>
            <div class="flex items-center gap-2">
                <span class="px-3 py-1 bg-yellow-400 text-black border-[2px] border-black font-black text-[10px] uppercase tracking-wider shadow-[2px_2px_0px_0px_#000]">Support</span>
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-16 flex-1 w-full">
        <div class="bg-white dark:bg-[#11131c] border-[3.5px] border-black p-8 md:p-12 shadow-[8px_8px_0px_0px_#000] dark:shadow-[8px_8px_0px_0px_#22d3ee] transition-all text-center">
            
            <div class="inline-flex items-center justify-center w-16 h-16 bg-rose-100 dark:bg-rose-950/40 text-rose-500 border-[3px] border-black shadow-[4px_4px_0px_0px_#000] mb-6 select-none">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>
            </div>
            
            <h2 class="text-3xl md:text-5xl font-black text-black dark:text-white uppercase tracking-tight mb-4 leading-none">Support the Project</h2>
            <p class="text-sm md:text-base font-medium text-gray-700 dark:text-gray-300 mb-8 max-w-xl mx-auto leading-relaxed">
                This tool is built to help aspirants save time and prepare efficiently. It is, and always will be, 100% free. If you found it helpful and want to support the server costs and development, you can buy me a coffee!
            </p>

            <!-- Disclaimer -->
            <div class="bg-yellow-400 text-black border-[3px] border-black p-5 mb-10 text-left shadow-[4px_4px_0px_0px_#000] max-w-xl mx-auto">
                <div class="flex gap-3">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-black" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-sm font-black uppercase tracking-wider">Important Student Disclaimer</h3>
                        <p class="mt-1 text-xs font-bold leading-relaxed">If you are a student, please do not donate more than Rs 50. Student lives are tough and I want you guys to utilize your money for something better!</p>
                    </div>
                </div>
            </div>

            <!-- QR Code Section -->
            <div class="flex flex-col items-center justify-center">
                <div class="bg-white border-[3px] border-black shadow-[6px_6px_0px_0px_#000] p-3 mb-8">
                    <img id="qrImage" src="upi_qr.jpg" alt="UPI QR Code" class="w-60 h-auto object-contain" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\\'w-60 h-60 flex flex-col items-center justify-center text-black p-4 text-center\\'><svg class=\\'w-12 h-12 mb-3 text-red-500\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\' stroke-width=\\'3\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' d=\\'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\\'></path></svg><span class=\\'text-xs font-black uppercase tracking-wider\\'>Image not found!</span><span class=\\'text-[10px] mt-2 font-bold text-gray-600\\'>Save QR code as upi_qr.jpg in project folder</span></div>';">
                </div>
                
                <!-- UPI ID Box -->
                <div class="bg-white text-black border-[3px] border-black p-4 flex items-center justify-between w-full max-w-sm shadow-[4px_4px_0px_0px_#000] mb-6">
                    <div class="flex flex-col text-left">
                        <span class="text-[9px] uppercase font-black text-gray-500 tracking-wider mb-1">Direct UPI ID</span>
                        <span id="upiIdText" class="text-sm font-extrabold font-mono">Undatedarc@axl</span>
                    </div>
                    <button onclick="navigator.clipboard.writeText('Undatedarc@axl').then(() => { const b = this; b.innerHTML = '<svg class=\\'w-5 h-5\\' fill=\\'currentColor\\' viewBox=\\'0 0 20 20\\'><path fill-rule=\\'evenodd\\' d=\\'M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\\' clip-rule=\\'evenodd\\'></path></svg>'; setTimeout(() => b.innerHTML = '<svg class=\\'w-5 h-5\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\' stroke-width=\\'2.5\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' d=\\'M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z\\'></path></svg>', 2000); })" class="p-2 bg-blue-100 hover:bg-blue-200 border-[2px] border-black text-black transition-colors cursor-pointer" title="Copy UPI ID">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    </button>
                </div>

                <p class="text-xs font-black uppercase text-gray-500 tracking-wider">Scan QR or copy UPI ID to support</p>
            </div>
        </div>
    </main>

    <!-- Premium Neo-Brutalist Footer -->
    <footer class="w-full bg-[#0d0e15] border-t-[3.5px] border-black text-gray-400 mt-auto">
        <div class="max-w-4xl mx-auto px-6 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10 pb-8 border-b-[2.5px] border-black/40 text-left">
                <!-- Column 1: Brand -->
                <div class="md:col-span-2 space-y-4">
                    <div class="flex items-center gap-3">
                        <img src="logo.png" alt="Logo" class="w-9 h-9 rounded-none border-[2.5px] border-black shadow-[2px_2px_0px_0px_#000] bg-white">
                        <span class="text-xl font-black text-white tracking-tight uppercase">PDF to PRACTICE</span>
                    </div>
                    <p class="text-xs font-bold text-gray-400 max-w-sm leading-relaxed">
                        Transform your coaching DPPs, PYQs, and test PDFs into interactive JEE/NEET CBT Mock Simulators instantly.
                    </p>
                    <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-wider text-black bg-emerald-400 border-[2px] border-black px-3 py-1.5 w-max">
                        <svg class="w-4 h-4 text-black shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        <span>100% Client-Side & Private</span>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="space-y-3">
                    <h4 class="text-xs font-black uppercase tracking-widest text-white">Quick Links</h4>
                    <ul class="space-y-2 text-xs font-bold">
                        <li><a href="/" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg> Dashboard</a></li>
                        <li><a href="/donate" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg> Support & Donate</a></li>
                    </ul>
                </div>

                <!-- Column 3: Legal -->
                <div class="space-y-3">
                    <h4 class="text-xs font-black uppercase tracking-widest text-white">Legal</h4>
                    <ul class="space-y-2 text-xs font-bold">
                        <li><a href="/terms" class="hover:text-cyan-400 transition-colors">Terms & Conditions</a></li>
                        <li><a href="/privacy" class="hover:text-cyan-400 transition-colors">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Credits -->
            <div class="flex flex-col sm:flex-row items-center justify-between text-[10px] uppercase font-black tracking-widest text-gray-500 gap-4">
                <p>&copy; 2026 PDF to PRACTICE.</p>
                <p class="flex items-center gap-1">
                    <span>Crafted for JEE & NEET Aspirants</span>
                </p>
            </div>
        </div>
    </footer>

    <script>
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIconSun = document.getElementById('themeIconSun');
        const themeIconMoon = document.getElementById('themeIconMoon');

        function updateThemeIcons() {
            if (document.documentElement.classList.contains('dark')) {
                themeIconSun.classList.remove('hidden');
                themeIconSun.classList.add('block');
                themeIconMoon.classList.remove('block');
                themeIconMoon.classList.add('hidden');
            } else {
                themeIconSun.classList.remove('block');
                themeIconSun.classList.add('hidden');
                themeIconMoon.classList.remove('hidden');
                themeIconMoon.classList.add('block');
            }
        }
        
        updateThemeIcons();

        themeToggleBtn.addEventListener('click', () => {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            updateThemeIcons();
        });
    </script>
</body>
</html>
