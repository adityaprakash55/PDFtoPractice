                </div>
            </div>

            <!-- Bottom Credits -->
            <div class="flex flex-col sm:flex-row items-center justify-between text-xs  gap-4">
                <p>&copy; 2026 PDF to PRACTICE. Built for JEE & NEET Aspirants.</p>
                <p class="flex items-center gap-1 ">
                    <span>Crafted with</span>
                    <svg class="w-3.5 h-3.5 text-rose-500 inline fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>
                    <span>for free education</span>
                </p>
            </div>
        </div>
    </footer>

    <script>
        // Dark mode toggle functionality
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIconSun = document.getElementById('themeIconSun');
        const themeIconMoon = document.getElementById('themeIconMoon');

        function updateThemeIcons() {
            if (document.documentElement.classList.contains('dark')) {
                themeIconSun.classList.remove('hidden');
                themeIconSun.classList.add('block');
                themeIconMoon.classList.remove('block');
                themeIconMoon.classList.add('hidden');
            } else {
                themeIconSun.classList.remove('block');
                themeIconSun.classList.add('hidden');
                themeIconMoon.classList.remove('hidden');
                themeIconMoon.classList.add('block');
            }
        }
        
        updateThemeIcons();

        themeToggleBtn.addEventListener('click', () => {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            updateThemeIcons();
        });
    </script>
</body>
</html>
