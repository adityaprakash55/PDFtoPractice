                    <button id="bmdDeleteGroupBtn" class="bg-red-500/10 hover:bg-red-500 text-red-500 hover: px-3 py-1.5 rounded-none text-base font-bold transition-colors flex items-center gap-1.5 border border-red-500/20 hover:border-red-500">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Delete Group
                    </button>
                    <button id="closeBookmarkDetailsBtn" class="hover: p-2 ml-2 transition-colors" aria-label="Close Bookmark Details">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
            </div>
            
            <!-- Question List -->
            <div id="bmdQuestionList" class="p-5 overflow-y-auto flex-1 hide-scrollbar flex flex-col gap-4 ">
                <!-- Injected via JS -->
            </div>
            
            <!-- Footer -->
            <div class="p-5 border-t border-white/10 shrink-0  rounded-b-2xl">
                <button id="bmdPracticeNowBtn" class="w-full bg-blue-500 hover:bg-blue-400 font-bold py-3 rounded-none text-xl transition-colors flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(59,130,246,0.3)]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Practice Now
                </button>
            </div>
        </div>
    </div>

    <!-- Bookmark Sidebar Overlay -->
    <div id="bookmarkSidebarOverlay" class="fixed inset-0 bg-black/60 z-[60] hidden transition-opacity duration-300 opacity-0"></div>

    <!-- Bookmark Sidebar -->
    <div id="bookmarkSidebar" class="fixed inset-y-0 right-0 w-full sm:w-96  z-[70] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-2xl border-l border-white/10">
        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b border-white/10 shrink-0">
            <div class="flex items-center gap-3">
                <div class="bg-blue-500 w-10 h-10 rounded-none flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                </div>
                <div>
                    <h3 class="font-bold text-xl leading-tight">Add to Bookmark</h3>
                    <p class="text-sm">Organize your questions</p>
                </div>
            </div>
            <button id="closeBookmarkSidebarBtn" class="hover: p-2" aria-label="Close bookmarks sidebar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="p-4 overflow-y-auto flex-1 hide-scrollbar">
            <!-- Quick Save Card -->
            <div id="quickSaveSection" class="bg-gradient-to-br from-blue-900/40 to-blue-800/20 border border-blue-500/30 rounded-none p-4 mb-6">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2 text-blue-400 font-bold">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"></path></svg>
                        <span>Quick Save to Chapter</span>
                    </div>
                    <span class="bg-[#FF9800] text-sm font-bold px-1.5 py-0.5 rounded">NEW</span>
                </div>
                <p class="text-sm text-blue-200/70 mb-4">Automatically save to <strong id="quickSaveChapterName" class="text-blue-100">Chapter</strong> chapter group for quick access later.</p>
                
                <div class="bg-[#060b14]/50 rounded-none p-3 mb-4 text-[11px]">
                    <div class="flex items-center gap-1.5 mb-1 font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        How to find this question:
                    </div>
                    <div>Physics &rsaquo; Chapters &rsaquo; <span id="quickSaveBreadcrumb" class="">Chapter</span> &rsaquo; More &rsaquo; <span class="">Bookmarked Questions</span></div>
                </div>

                <button id="quickSaveBtn" class="w-full bg-blue-500 hover:bg-blue-400 font-bold py-2 rounded-none text-base flex items-center justify-center gap-2 transition-colors shadow-[0_0_15px_rgba(59,130,246,0.3)]">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"></path></svg>
                    Save to <span id="quickSaveBtnChapter">Chapter</span>
                </button>
            </div>

            <!-- Custom Groups -->
            <div class="flex items-center gap-2 mb-3 px-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"></path></svg>
                <h4 class="font-bold">Your Bookmark Groups</h4>
                <span id="bookmarkGroupCount" class="bg-white/10 text-sm px-2 py-0.5 rounded-full">0</span>
            </div>

            <div id="bookmarkGroupsList" class="flex flex-col gap-2">
                <!-- Groups injected here -->
            </div>
        </div>

        <!-- Footer / Create Group -->
        <div class="p-4 border-t border-white/10 shrink-0 bg-[#060b14]">
            <button id="createBookmarkGroupBtn" class="w-full bg-blue-500 hover:bg-blue-400 font-bold py-2.5 rounded-none flex items-center justify-center gap-2 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Create New Group
            </button>
            <p class="text-center text-[11px] mt-2 flex items-center justify-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Maximum 90 questions per group
            </p>
        </div>
    </div>

    <!-- Leaderboard Modal -->
    <div id="leaderboardModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/60">
        <div class="brutal-card rounded-none shadow-2xl max-w-3xl w-full overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-gradient-to-r from-purple-600 to-blue-600 p-6 relative">
                <h2 class="text-4xl font-extrabold text-center flex items-center justify-center gap-3">
                    <svg class="w-8 h-8 text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2.5a.5.5 0 01.5.5v1.25l1.615.808a2 2 0 011.118 1.118l.808 1.615V9.5a.5.5 0 01-1 0V7.793l-.808-1.615a1 1 0 00-.559-.559L10 4.811 8.385 5.62a1 1 0 00-.559.559l-.808 1.615V9.5a.5.5 0 01-1 0V7.793l.808-1.615a2 2 0 011.118-1.118l1.615-.808V3a.5.5 0 01.5-.5zM5 11.5a.5.5 0 011 0V13h8v-1.5a.5.5 0 011 0V14a1 1 0 01-1 1H6a1 1 0 01-1-1v-2.5z" clip-rule="evenodd"></path></svg>
                    Live Practice Leaderboard
                </h2>
                <button id="closeLeaderboardBtn" class="absolute top-4 right-4 /80 hover: bg-white/10 hover:bg-white/20 p-2 rounded-full transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            
            <!-- Table -->
            <div class="overflow-y-auto p-6 bg-gray-50  flex-1">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-sm uppercase dark: border-b ">
                            <th class="pb-3 font-semibold">Rank</th>
                            <th class="pb-3 font-semibold">Participant</th>
                            <th class="pb-3 font-semibold text-right">Score</th>
                            <th class="pb-3 font-semibold text-right">Accuracy</th>
                        </tr>
                    </thead>
                    <tbody id="leaderboardTbody" class="divide-y divide-gray-200 dark:divide-navy-800">
                        <!-- Leaderboard rows injected here -->
                    </tbody>
                </table>
            </div>
            
            <div class="p-6 brutal-card border-t  flex justify-center">
                <button id="exitLiveTestBtn" class="bg-gray-200  hover:bg-gray-300 dark:hover:bg-navy-700 dark: font-bold py-2.5 px-8 rounded-none transition-colors">
                    Exit to Home
                </button>
            </div>
        </div>
    </div>
    <!-- Test Instructions & Setup Modal -->
    <div id="testInstructionsModal" class="hidden fixed inset-0 bg-black/80 z-[99999] flex items-center justify-center p-4">
        <div class="brutal-card border-[3.5px] border-black max-w-lg w-full p-8 text-left shadow-[8px_8px_0px_0px_#000] relative overflow-hidden flex flex-col gap-5">
            <!-- Header -->
            <div class="flex items-start justify-between border-b border-black pb-4">
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-1">Test Instructions</span>
                    <h3 id="instructionsModalTitle" class="text-lg font-bold leading-tight">Mock Test Session</h3>
                    <p id="instructionsModalSubtitle" class="text-xs mt-0.5">25 Questions • Standard Marking</p>
                </div>
                <button id="closeInstructionsModalBtn" class="hover: p-1 rounded-none hover:bg-gray-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Rename Test Field -->
            <div class="bg-[#141924] p-3 rounded-none /60 flex flex-col gap-1">
                <label for="instructionsModalTitleInput" class="text-[10px] font-bold uppercase tracking-widest">Test Name / Title</label>
                <input type="text" id="instructionsModalTitleInput" placeholder="Enter test name..." class="w-full brutal-card text-xs rounded-none px-3 py-2 focus:outline-none focus:border-blue-500 font-semibold transition-colors" />
            </div>

            <!-- Rules & Guidelines -->
            <div class="space-y-3 text-xs">
                <div class="flex items-start gap-2.5 bg-[#141924] p-3 rounded-none /60">
                    <div class="text-blue-400 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                    <div>
                        <strong class="">Timer & Duration:</strong>
                        <p class="text-[11px] mt-0.5">The countdown timer starts as soon as you click "Start Exam Now". Manage your time wisely.</p>
                    </div>
                </div>
                <div class="flex items-start gap-2.5 bg-[#141924] p-3 rounded-none /60">
                    <div class="text-emerald-400 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                    <div>
                        <strong class="">Scoring Scheme:</strong>
                        <p class="text-[11px] mt-0.5">Correct response: <span class="text-emerald-400 font-bold">+4</span> • Incorrect response: <span class="text-red-400 font-bold">-1</span></p>
                    </div>
                </div>
                <div class="flex items-start gap-2.5 bg-[#141924] p-3 rounded-none /60">
                    <div class="text-purple-400 mt-0.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                    <div>
                        <strong class="">Navigation:</strong>
                        <p class="text-[11px] mt-0.5">Use the question palette to jump between questions. You can save, clear, or mark questions for review.</p>
                    </div>
                </div>
            </div>

            <!-- Modal Action Footer -->
            <div class="flex items-center justify-end gap-3 border-t border-black pt-4">
                <button id="cancelInstructionsModalBtn" class="px-4 py-2.5 rounded-none text-xs font-semibold hover: hover:bg-gray-800 transition-colors">
                    Cancel
                </button>
                <button id="confirmStartTestBtn" class="flex items-center gap-2 px-6 py-2.5 rounded-none text-xs font-bold bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30 transition-all active:scale-95">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
                    Start Exam Now
                </button>
            </div>
        </div>
    </div>
    

