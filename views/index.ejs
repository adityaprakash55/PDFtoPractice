<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>">
    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.png">
    <!-- SEO & Meta Tags -->
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="JEE Main, NEET, Mock Test Simulator, PDF question extractor, auto slice questions, CBT practice, IIT JEE prep, NEET prep">
    <meta name="author" content="JEE/NEET Prep Tools">
    <meta property="og:title" content="JEE/NEET Auto PDF Mock Test Simulator">
    <meta property="og:description" content="Turn your PDFs into interactive Computer Based Tests (CBT). Client-side, serverless, secure.">
    <meta property="og:type" content="website">

    <!-- Vercel Speed Insights -->
    <script>
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    </noscript>

    <!-- Local CSS -->
    <style><%- include('../public/styles.css') %></style>
    <script>
        // Check for saved theme preference or use system preference safely
        try {
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        } catch (e) {
            // Safari private mode might throw error, fallback to system preference
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
            }
        }
    </script>
    
    <!-- PeerJS -->
    <script defer src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>

    <!-- PDF.js -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

    <!-- JSZip & FileSaver -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <style>
        .margin-line {
            cursor: ns-resize;
        }
        .nta-not-visited {
            background-color: #f3f4f6;
            color: #000;
        }
        .nta-not-answered {
            background-color: #d9534f;
            color: white;
            clip-path: polygon(0 0, 100% 0, 100% 75%, 50% 100%, 0 75%);
            border-radius: 0 0 10% 10%;
        }
        .nta-answered {
            background-color: #5cb85c;
            color: white;
            border-radius: 100% 100% 0 0;
            clip-path: polygon(50% 0%, 100% 25%, 100% 100%, 0% 100%, 0% 25%);
        }
        .nta-marked {
            background-color: #5bc0de;
            color: white;
            border-radius: 9999px;
        }
        .nta-answered-marked {
            background-color: #5bc0de;
            color: white;
            border-radius: 9999px;
        }
        .margin-line::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background-color: rgb(239, 68, 68);
        }
        .margin-line:hover::after {
            background-color: rgb(220, 38, 38);
            height: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* NTA Palette Shapes and Colors */
        .nta-not-visited { background-color: #e5e7eb; border: 2px solid #d1d5db; color: #1f2937; }
        .dark .nta-not-visited { background-color: #374151; border: 2px solid #4b5563; color: #ffffff; }
        .nta-not-answered { background-color: #F28C28; border-color: #d97a22; color: white; border-radius: 0 0 10px 10px; }
        .nta-answered { background-color: #22c55e; border-color: #16a34a; color: white; border-radius: 10px 10px 0 0; }
        .nta-marked { background-color: #9333ea; border-color: #7e22ce; color: white; border-radius: 50%; }
        .nta-answered-marked { background-color: #9333ea; border-color: #7e22ce; color: white; border-radius: 50%; }
        .nta-wrong { background-color: #ef4444; border-color: #dc2626; color: white; border-radius: 10px 10px 0 0; }

        /* GenZ Animations & Mesh */
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
        
        .brutal-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .dark .brutal-card {
            background: rgba(15, 23, 42, 0.85) !important;
            backdrop-filter: blur(16px) !important;
            -webkit-backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: none !important;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #liveResultsDashboard, #liveResultsDashboard * {
                visibility: visible;
            }
            #liveResultsDashboard {
                position: absolute;
                left: 0;
                top: 0;
                right: 0;
                bottom: 0;
                overflow: visible !important;
                background: white !important;
                color: black !important;
                display: block !important;
            }
            .lrd-panel {
                overflow: visible !important;
                height: auto !important;
                page-break-inside: auto;
            }
            .lrd-panel > * {
                page-break-inside: avoid;
            }
            /* Hide the sidebar, exit button, and PDF button in print */
            aside, #lrdExitBtn, #lrdDownloadPdfBtn {
                display: none !important;
            }
            /* Dark mode text colors override for print */
            ., ., ., . {
                color: #000 !important;
            }
            .bg-gray-800\/40, .bg-gray-900\/70, .bg-\[\#1C212E\] {
                background-color: #fff !important;
                border: 1px solid #ddd !important;
            }
        }
    </style>
    <link rel="preload" href="logo-light.png" as="image">
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- Safari & Apple Specific Meta -->
    <link rel="apple-touch-icon" href="/logo-light.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#0a192f">

    <!-- Universal Social/Search Cards (Brave, Twitter, etc.) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://pdftopractice.in/logo-light.png">
