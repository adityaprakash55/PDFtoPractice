<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="canonical" href="<%= canonical %>">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Local CSS -->
    <link rel="stylesheet" href="/styles.css">
    <link rel="preload" href="logo.png" as="image">

    <!-- Safari & Apple Specific Meta -->
    <link rel="apple-touch-icon" href="/logo.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#0a192f">

    <!-- Universal Social/Search Cards (Brave, Twitter, etc.) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://pdftopractice.in/logo.png">
    <meta property="og:image" content="https://pdftopractice.in/logo.png">


    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon.png">
</head>
<body class="dark: font-sans min-h-screen">
    <header class="sticky top-0 z-40 bg-white/70 dark:bg-slate-900/70 shadow-sm">
        <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-2 text-blue-600 hover:text-blue-700 font-semibold group cursor-pointer" title="PDF to PRACTICE - Home">
                <img src="/logo-light.png" alt="Logo" class="w-7 h-7 rounded-none dark:hidden">
                <img src="/logo-dark.png" alt="Logo" class="w-7 h-7 rounded-none hidden dark:block">
                <span class="font-bold text-lg dark:text-white" style="color: var(--text-primary);">PDF to PRACTICE</span>
            </a>
            <div class="flex items-center space-x-3 text-sm font-semibold">
                <a href="https://t.me/PDFtoPractice" target="_blank" rel="noopener" class="text-[#229ED9] hover:underline flex items-center gap-1">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.562 8.161c-.18.717-.962 4.084-1.362 5.752-.169.706-.433.943-.684.966-.547.05-1.002-.387-1.533-.735-.83-.544-1.301-.883-2.107-1.413-.93-.614-.327-.951.203-1.503.138-.144 2.535-2.324 2.582-2.523.006-.025.01-.119-.045-.168s-.136-.032-.195-.019c-.083.018-1.408.895-3.974 2.628-.376.258-.717.385-1.022.378-.337-.008-.985-.191-1.467-.348-.592-.192-1.062-.294-1.021-.621.021-.17.256-.345.704-.524 2.766-1.204 4.61-1.998 5.534-2.383 2.637-1.099 3.183-1.29 3.539-1.296.078-.001.253.018.366.11.096.078.123.184.135.258.012.075.027.243.014.408z"/></svg>
                    <span class="hidden sm:inline">Telegram</span>
                </a>
                <a href="mailto:support@pdftopractice.in" class="text-amber-600 hover:underline flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span class="hidden sm:inline">Email</span>
                </a>
                <a href="/contact" class="text-emerald-600 hover:underline flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    <span>Contact Us</span>
                </a>
            </div>
        </div>
    </header>
    <main class="max-w-4xl mx-auto px-4 py-12">
        <h1 class="text-3xl md:text-4xl font-extrabold mb-8 tracking-tight">Terms & Conditions</h1>
        <div class="prose dark:prose-invert max-w-none text-lg dark: space-y-6">
            <p><strong>Last Updated:</strong> July 2026</p>
            <p>By accessing and using the PDF to PRACTICE, you agree to comply with and be bound by the following terms and conditions.</p>
            
